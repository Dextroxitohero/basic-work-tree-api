# Se usa el puerto 5440 del host para no chocar con otros PostgreSQL locales.
DATABASE_URL=postgresql+asyncpg://employee:employee@localhost:5440/employee_db
DATABASE_URL_TEST=postgresql+asyncpg://employee:employee@localhost:5440/employee_db_test

# Pool de conexiones. OJO: es POR WORKER (4 workers x 15 = 60 conexiones).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Autenticación propia. Las tres son OBLIGATORIAS y no tienen valor por defecto:
# la app no arranca si faltan.
# Secreto que firma los tokens (mínimo 32 caracteres). Quien lo conozca puede fabricar
# tokens de admin. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Administrador inicial: se crea (o se restaura) en cada arranque. Contraseña de 12+ caracteres.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

DEBUG=false

# Orígenes del front permitidos por CORS, separados por comas (sin barra final).
CORS_ORIGINS=http://localhost:5173
