# Se usa el puerto 5440 del host para no chocar con otros PostgreSQL locales.
DATABASE_URL=postgresql+asyncpg://employee:employee@localhost:5440/employee_db
DATABASE_URL_TEST=postgresql+asyncpg://employee:employee@localhost:5440/employee_db_test

# Pool de conexiones. OJO: es POR WORKER (4 workers x 15 = 60 conexiones).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Autenticación: "auth0", o "local" SOLO para desarrollo (sin cuenta de Auth0).
AUTH_MODE=auth0
# Obligatorio con AUTH_MODE=local (mínimo 32 caracteres). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# LOCAL_JWT_SECRET=

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://employee-api

DEBUG=false
