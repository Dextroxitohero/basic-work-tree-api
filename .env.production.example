# Entorno de producción (APP_ENV=production).
#
# En Railway no se usa un archivo: pega estas variables en el servicio de la API, en
# Variables > Raw Editor. Si quieres ejecutar algo en local contra producción (migraciones, por
# ejemplo), cópialo como .env.production y cambia DATABASE_URL por la URL PÚBLICA de la base.
#
# En production la app NO arranca si: DEBUG=true, CORS_ORIGINS contiene * o DATABASE_URL apunta
# a una base de datos local.
APP_ENV=production

# Referencia al servicio de Postgres de Railway (si tu servicio no se llama Postgres, cambia el
# nombre). postgres:// se convierte solo al driver asyncpg.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Obligatorias, sin valor por defecto. Usa valores distintos a los de dev.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEBUG=false

# Railway pone UN proxy delante de la API (la imagen Docker ya lo fija en 1). Súbelo a 2 si hay
# otro delante, como un CDN.
TRUSTED_PROXY_HOPS=1

# Orígenes del front en producción, separados por comas, sin barra final y sin *.
CORS_ORIGINS=https://URL-DE-TU-FRONT.up.railway.app
